# Database Connection URL (e.g., jdbc:postgresql://localhost:5432/isopod)
DB_URL=

# Database Username
DB_USERNAME=

# Database Password
DB_PASSWORD=

# Secret key used for signing JWT tokens (should be a strong, random string)
JWT_SECRET=

# Local directory path where Docker workspace volumes will be created (points to monorepo root)
WORKSPACE_ROOT=

# Docker daemon socket. Defaults to the Docker Desktop Linux engine pipe on Windows.
# Override if using a different context (e.g., unix:///var/run/docker.sock on Linux/macOS).
DOCKER_HOST=
