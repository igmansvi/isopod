# Database connection string.
# Example: postgres://user:password@localhost:5432/isopod
DATABASE_URL=

# Base URL of the application used by NextAuth.
# Example: http://localhost:3000
NEXTAUTH_URL=

# Secret used by NextAuth for signing and encryption.
NEXTAUTH_SECRET=

# Root directory for workspace storage.
# Example: /var/lib/isopod/workspaces
WORKSPACES_ROOT=
